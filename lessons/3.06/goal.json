{
  "questions": [
    {
      "id": "full-length",
      "prompt": "How many characters does a full commit id have?",
      "type": "number",
      "answer": 40
    },
    {
      "id": "min-prefix",
      "prompt": "What is the shortest prefix length git accepts for a commit id?",
      "type": "number",
      "answer": 4
    },
    {
      "id": "v1-commit",
      "prompt": "Which commit does tag v1.0 point to? Answer with only the first 4 characters of its id.",
      "type": "commit",
      "answer": "@mark:merge"
    }
  ],
  "goals": [
    {
      "label": "Show a commit using a short id (4 to 12 characters)",
      "check": {
        "type": "usedCommand",
        "matches": "^git show( \\S+)* [0-9a-f]{4,12}( |$)"
      }
    },
    {
      "label": "See git refuse a prefix that is too short",
      "check": {
        "type": "usedCommand",
        "matches": "^git show( \\S+)* [0-9a-f]{1,3}( |$)",
        "exitCode": 128
      }
    },
    {
      "label": "Show a commit using its full 40-character id",
      "check": {
        "type": "usedCommand",
        "matches": "^git show( \\S+)* [0-9a-f]{40}( |$)"
      }
    },
    {
      "label": "Answer: full id length",
      "check": {
        "type": "answer",
        "question": "full-length"
      }
    },
    {
      "label": "Answer: shortest accepted prefix",
      "check": {
        "type": "answer",
        "question": "min-prefix"
      }
    },
    {
      "label": "Answer: the v1.0 commit by its 4-character prefix",
      "check": {
        "type": "answer",
        "question": "v1-commit"
      }
    }
  ]
}
