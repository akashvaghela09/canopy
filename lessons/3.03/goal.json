{
  "questions": [
    {
      "id": "sam-count",
      "prompt": "How many commits did Sam Chen make?",
      "type": "number",
      "answer": 5
    },
    {
      "id": "week-count",
      "prompt": "How many commits were made between March 11 and March 17, 2024 (inclusive)?",
      "type": "number",
      "answer": 3
    },
    {
      "id": "typo-commit",
      "prompt": "Which commit has a message that mentions a typo?",
