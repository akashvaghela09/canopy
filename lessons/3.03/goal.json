      "answer": "@mark:typo"
    }
  ],
  "goals": [
    { "label": "Filter by author", "check": { "type": "usedCommand", "matches": "^git log\\b.*--author" } },
    { "label": "Filter by date", "check": { "type": "usedCommand", "matches": "^git log\\b.*--(since|until|after|before)" } },
    { "label": "Filter by message text", "check": { "type": "usedCommand", "matches": "^git log\\b.*--grep" } },
    { "label": "Answer: Sam's commits", "check": { "type": "answer", "question": "sam-count" } },
    { "label": "Answer: commits that week", "check": { "type": "answer", "question": "week-count" } },
    { "label": "Answer: the typo commit", "check": { "type": "answer", "question": "typo-commit" } }
  ]
}
