    {
      "id": "what-add-does",
      "prompt": "What does staging a file do, at the object level?",
      "type": "choice",
      "options": [
        "Writes a blob into objects/ and records its id, mode and path in the index",
        "Copies the file into .git/staging/",
        "Creates a commit object without a message",
        "Writes the file name into HEAD"
      ],
      "answer": 0
    }
  ],
  "goals": [
    {
      "label": "List the index with git ls-files -s",
      "check": {
        "type": "usedCommand",
        "matches": "\\bgit ls-files\\b.*\\s(-[a-zA-Z]*s[a-zA-Z]*|--stage)\\b"
      }
    },
    {
      "label": "Count the entries at the start",
      "check": {
        "type": "answer",
        "question": "count-start"
      }
    },
    {
      "label": "Stage notes.txt",
      "check": {
        "type": "status",
        "staged": [
          "notes.txt"
        ]
      }
    },
    {
      "label": "Read the blob id of notes.txt from the index",
      "check": {
        "type": "answer",
        "question": "notes-blob"
      }
    },
    {
      "label": "Use git update-index to stage extra.txt",
      "check": {
        "type": "usedCommand",
        "matches": "\\bgit update-index\\b.*extra\\.txt"
      }
    },
    {
      "label": "extra.txt is in the index",
      "check": {
        "type": "status",
        "staged": [
          "extra.txt"
        ]
      }
    },
    {
      "label": "Say what staging does",
      "check": {
        "type": "answer",
        "question": "what-add-does"
      }
    }
  ]
}
