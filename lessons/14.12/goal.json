  "goals": [
    {
      "label": "Create sha-repo with the SHA-256 object format",
      "check": {
        "type": "config",
        "repo": "sha-repo",
        "key": "extensions.objectformat",
        "value": "sha256",
        "scope": "local"
      }
    },
    {
      "label": "Commit README.md containing hello in sha-repo",
      "check": {
        "type": "fileContent",
        "repo": "sha-repo",
        "source": "HEAD",
        "path": "README.md",
        "contains": "hello"
      }
    },
