  "goals": [
    {
      "label": "Use shortlog",
      "check": {
        "type": "usedCommand",
        "matches": "^git(\\s+(--no-pager|-C\\s+\\S+|-c\\s+\\S+))*\\s+shortlog\\b"
      }
    },
    {
      "label": "Limit shortlog to a period",
      "check": {
        "type": "usedCommand",
        "matches": "^git(\\s+(--no-pager|-C\\s+\\S+|-c\\s+\\S+))*\\s+shortlog\\b.*--(since|after|until|before)\\b"
      }
    },
    {
      "label": "Top contributor overall",
