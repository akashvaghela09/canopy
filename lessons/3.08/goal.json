      "id": "same-commit",
      "prompt": "HEAD~4 and HEAD~3^1 are:",
      "type": "choice",
      "options": [
        "The same commit, because ~ follows the first parent",
        "Different commits, one on each side of the merge",
        "Both the merge commit itself",
        "Invalid, because ^1 only works on HEAD"
      ],
      "answer": 0
    },
    {
      "id": "tilde-vs-caret",
      "prompt": "What is the difference between ~ and ^?",
      "type": "choice",
      "options": [
        "~N goes back N generations along first parents; ^N picks the Nth parent of one commit",
        "~ counts forward in time and ^ counts backward",
        "There is none; they are two spellings of the same thing",
        "^ only works with tags and ~ only works with branches"
      ],
      "answer": 0
    }
