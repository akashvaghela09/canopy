    { "label": "Show the merge's second parent using ^2", "check": { "type": "usedCommand", "matches": "^git (show|log)\\b.*\\^2" } },
    { "label": "Answer: HEAD~2", "check": { "type": "answer", "question": "head-2" } },
    { "label": "Answer: HEAD~3^2", "check": { "type": "answer", "question": "head-3-2" } },
    { "label": "Answer: HEAD~4 vs HEAD~3^1", "check": { "type": "answer", "question": "same-commit" } },
