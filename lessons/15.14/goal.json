{
  "questions": [
    {
      "id": "refused",
      "prompt": "Why did the four-branch merge stop?",
      "type": "choice",
      "options": [
        "Octopus does not resolve conflicts itself; clash and header changed the same line of theme.css, so the merge stopped",
        "git allows at most three branches in one merge",
        "clash had no common ancestor with main",
        "The branches had to be merged in alphabetical order"
      ],
      "answer": 0
    }
  ],
  "goals": [
    {
      "label": "Attempt the merge that includes clash",
      "check": {
        "type": "usedCommand",
        "matches": "\\bgit merge\\b.*\\bclash\\b",
        "exitCode": null
      }
    },
    {
      "label": "main is an octopus merge commit with four parents",
      "check": {
        "type": "all",
        "checks": [
          {
            "type": "commitParents",
            "rev": "main",
            "count": 4
          },
          {
            "type": "isAncestor",
            "ancestor": "@mark:header",
            "descendant": "main"
          },
          {
            "type": "isAncestor",
            "ancestor": "@mark:footer",
            "descendant": "main"
          },
          {
            "type": "isAncestor",
            "ancestor": "@mark:sidebar",
            "descendant": "main"
          }
        ]
      }
    },
    {
      "label": "clash is not merged",
      "check": {
        "type": "not",
        "check": {
          "type": "isAncestor",
          "ancestor": "@mark:clash",
          "descendant": "main"
        }
      }
    },
    {
      "label": "No merge in progress, clean tree",
      "check": {
        "type": "all",
        "checks": [
          {
            "type": "operation",
            "value": null
          },
          {
            "type": "status",
            "clean": true
          }
        ]
      }
    },
    {
      "label": "Explain the refusal",
      "check": {
        "type": "answer",
        "question": "refused"
      }
    }
  ]
}
