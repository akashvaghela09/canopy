        { "type": "fileContent", "source": "main", "path": "report.py", "contains": "round(avg, 2)" },
        { "type": "fileContent", "source": "main", "path": "report.py", "notContains": "DEBUG" }
      ] } },
    { "label": "The DEBUG lines are still in the working tree, unstaged", "check": { "type": "all", "checks": [
        { "type": "fileContent", "source": "worktree", "path": "report.py", "contains": "DEBUG count" },
        { "type": "fileContent", "source": "worktree", "path": "report.py", "contains": "DEBUG rows" },
        { "type": "status", "modified": ["report.py"], "staged": [], "exact": true }
      ] } }
  ]
