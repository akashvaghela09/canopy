    { "label": "One new commit holds both rounding fixes and no DEBUG line", "check": { "type": "all", "checks": [
        { "type": "commitCount", "range": "main", "equals": 2 },
        { "type": "commitMessage", "rev": "main", "equals": "Fix rounding in report" },
